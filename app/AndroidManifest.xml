<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.dolby.atmos">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <application
        android:label="Dolby Atmos"
        android:allowBackup="false"
        android:hardwareAccelerated="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Black.NoTitleBar"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- плитка в шторке быстрых настроек -->
        <service
            android:name=".DolbyTileService"
            android:exported="true"
            android:label="Dolby Atmos"
            android:icon="@android:drawable/ic_media_play"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- кнопки уведомления -->
        <receiver android:name=".ToggleReceiver" android:exported="false">
            <intent-filter>
                <action android:name="com.dolby.atmos.TOGGLE" />
                <action android:name="com.dolby.atmos.SET_ON" />
                <action android:name="com.dolby.atmos.SET_OFF" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
